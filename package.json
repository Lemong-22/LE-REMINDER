{
	"name": "LE-REMINDER",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^6",
			"lucide-react": "^0.546.0",
			"next": "^16.2.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.6",
			"react-dom": "^19.2.6",
			"sonner": "^2.0.5",
			"@libsql/client": "0.15.15",
			"libsql": "0.5.22",
			"@trpc/server": "^11.16.0",
			"@trpc/client": "^11.16.0",
			"@types/react": "^19.2.15",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.1.18"
		}
	},
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"check-types": "bun run --filter '*' check-types",
		"dev:web": "bun run --filter web dev",
		"db:push": "bun run --filter @LE-REMINDER/db db:push",
		"db:studio": "bun run --filter @LE-REMINDER/db db:studio",
		"db:generate": "bun run --filter @LE-REMINDER/db db:generate",
		"db:migrate": "bun run --filter @LE-REMINDER/db db:migrate",
		"db:local": "bun run --filter @LE-REMINDER/db db:local",
		"check": "biome check --write ."
	},
	"packageManager": "bun@1.3.14",
	"dependencies": {
		"dotenv": "catalog:",
		"zod": "catalog:",
		"@LE-REMINDER/env": "workspace:*"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/node": "^22.13.14",
		"@LE-REMINDER/config": "workspace:*",
		"@biomejs/biome": "^2.2.0",
		"lefthook": "^2.0.13"
	}
}
