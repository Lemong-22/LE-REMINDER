{
	"extends": "@LE-REMINDER/config/tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"@/domain/*": ["./src/domain/*"],
			"@/application/*": ["./src/application/*"],
			"@/infrastructure/*": ["./src/infrastructure/*"],
			"@/interface/*": ["./src/interface/*"],
			"@/lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src/**/*", "apps/**/*", "packages/**/*"],
	"exclude": ["node_modules", ".next", "dist"]
}
