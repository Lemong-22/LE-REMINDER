# LE-REMINDER Environment Variables
# ===================================
# Copy this file to apps/web/.env and fill in the values.

# Database (Turso / libSQL)
# ---------------------------------
# Local dev: a plain SQLite file, no Turso account or auth token needed.
DATABASE_URL=file:./data/local.db

# Production: a real Turso database.
# DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Auth (Better Auth, GitHub OAuth only — Phase 0.5)
# ---------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local dev: http://localhost:3001  |  Production: your deployed URL
BETTER_AUTH_URL=http://localhost:3001

# Register an OAuth app at https://github.com/settings/developers
# Homepage URL = BETTER_AUTH_URL, Authorization callback URL =
# {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The single email allowed to sign in. Any other GitHub account is
# rejected at account-creation time (see packages/auth/src/auth.ts).
ALLOWED_EMAIL=you@example.com
